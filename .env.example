# ---------------------------------------------------------------------------
# NIMAP — local development configuration
#
# Copy to .env and adjust. Values here are only used outside Docker;
# docker-compose.yml sets its own environment.
# ---------------------------------------------------------------------------

# Runtime environment: development | production
SERVICE_ENV=development

# HTTP port
SERVICE_PORT=8080

# Public URL nimap is reached at. Required for single sign-on; the OIDC
# callback URL is derived from it as <base url>/api/auth/oidc/callback.
SERVICE_BASE_URL=http://localhost:8080

# PostgreSQL connection string (required).
# Points at the database started by `make db`.
SERVICE_DATABASE_URL=postgres://nimap:nimap@localhost:5432/nimap?sslmode=disable

# Directory for uploaded photos, floor plans and generated thumbnails
SERVICE_MEDIA_DIR=./data/media

# Logging: debug | info | warn | error, and text | json
SERVICE_LOG_LEVEL=debug
SERVICE_LOG_FORMAT=text

# Run pending migrations on startup
SERVICE_AUTO_MIGRATE=true

# Single sign-on through an OIDC provider (Keycloak, Entra ID, Google, ...).
# Leave SERVICE_OIDC_ISSUER empty to disable it. Register
# <SERVICE_BASE_URL>/api/auth/oidc/callback as the redirect URI at the provider.
# SERVICE_OIDC_ISSUER=http://localhost:8180/realms/nimap
# SERVICE_OIDC_CLIENT_ID=nimap
# SERVICE_OIDC_CLIENT_SECRET=
# SERVICE_OIDC_NAME=SSO
# SERVICE_OIDC_SCOPES=openid,email,profile
# Comma-separated email domains allowed to sign up; empty allows anyone the provider lets in
# SERVICE_OIDC_ALLOWED_DOMAINS=
# SERVICE_OIDC_LINK_BY_EMAIL=true
